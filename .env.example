# ===================================================
# ViewFlow Server Backend Environment Template
# ===================================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/viewflow?retryWrites=true&w=majority

# JWT Secret Key for Session & Multi-Tenancy Token Verification
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend Application Origin (CORS Allowed URL)
FRONTEND_URL=http://localhost:3000

# Cloudinary Credentials (Free Cloudinary tier for Property Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 100% Free Email Delivery via Gmail SMTP (Zero paid subscriptions needed)
# Generate a Google 16-character App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password

# (Optional) Free WhatsApp Alerts via CallMeBot API: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# WHATSAPP_API_KEY=your_callmebot_api_key
# WHATSAPP_PHONE=+1234567890
